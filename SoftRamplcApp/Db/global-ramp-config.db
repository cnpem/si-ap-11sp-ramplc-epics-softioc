record(ao, "$(P)$(R)CurrentStep-SP") {
    field(DESC, "Step of the current ramp")
    field(EGU, "A")
    field(OUT, "$(P)$(R)CurrentStep-RB PP")
}

record(ai, "$(P)$(R)CurrentStep-RB") {
    field(DESC, "Step of the current ramp Readback")
    field(EGU, "A")
}

record(bo, "$(P)$(R)Start-Cmd") {
    field(DESC, "Enable the current ramp")
    field(ZNAM, "Disabled")
    field(ONAM, "Enabled")
}

# Checks if writing to the foils is enabled - i.e if the user wants it to ramp
# (Start-Cmd) and the feedfoward loop is disabled (LoopState-Sts)

record(calcout, "$(P)$(R)CheckWriting") {
    field(INPA, "$(P)$(R)Start-Cmd CP")
    field(INPB, "$(P)BS-IDFF-LC:LoopState-Sts CP")

    field(CALC, "A && !B")

    field(OUT, "$(P)$(R)Writing-Sts PP")
}

record(bo, "$(P)$(R)Writing-Sts") {
    field(DESC, "Check if writing is enabled")
    field(ZNAM, "Disabled")
    field(ONAM, "Enabled")
}
